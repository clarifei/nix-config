+std::vector<std::uint32_t> PipeWireService::programOutputGroupIds(std::uint32_t id) const {
+  const auto selected = m_nodes.find(id);
+  if (selected == m_nodes.end() || selected->second == nullptr || !isProgramOutputNode(*selected->second)) {
+    return {};
+  }
+
+  const std::uint64_t groupKey = programOutputGroupKey({
+      .processId = selected->second->applicationProcessId,
+      .clientId = selected->second->clientId,
+  });
+  if (groupKey == 0) {
+    return {id};
+  }
+
+  std::vector<std::uint32_t> ids;
+  for (const auto& [nodeId, node] : m_nodes) {
+    if (node != nullptr
+        && programOutputGroupKey({.processId = node->applicationProcessId, .clientId = node->clientId}) == groupKey
+        && isProgramOutputNode(*node)) {
+      ids.push_back(nodeId);
+    }
+  }
+  std::ranges::sort(ids);
+  return ids;
+}
