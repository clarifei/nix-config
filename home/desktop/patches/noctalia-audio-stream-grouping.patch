+void PipeWireService::setProgramOutputVolume(std::uint32_t id, float volume) {
+  const float clamped = std::clamp(volume, 0.0f, 1.5f);
+  bool changed = false;
+  for (const std::uint32_t nodeId : programOutputGroupIds(id)) {
+    const auto it = m_nodes.find(nodeId);
+    if (it == m_nodes.end() || it->second == nullptr) {
+      continue;
+    }
+    const std::string& appBinary = it->second->applicationBinary;
+    if (!appBinary.empty()) {
+      m_userAppVolumes[appBinary] = clamped;
+    }
+    if (applyNodeVolume(nodeId, clamped)) {
+      changed = true;
+    }
+  }
+  if (changed) {
+    rebuildState();
+  }
+}
