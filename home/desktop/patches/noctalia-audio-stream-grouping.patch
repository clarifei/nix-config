diff --git a/src/pipewire/program_output_group_key.h b/src/pipewire/program_output_group_key.h
new file mode 100644
index 0000000..2ae89f1
--- /dev/null
+++ b/src/pipewire/program_output_group_key.h
@@ -0,0 +1,19 @@
+#pragma once
+
+#include <cstdint>
+
+struct ProgramOutputIdentity {
+  std::uint32_t processId = 0;
+  std::uint32_t clientId = 0;
+};
+
+// Keep process and client identifiers in separate namespaces. Chromium creates short-lived
+// PipeWire clients for one audio-service process, so the process is the stable identity when it is
+// available. Client identity remains a conservative fallback for applications that omit the PID.
+[[nodiscard]] constexpr std::uint64_t programOutputGroupKey(ProgramOutputIdentity identity) noexcept {
+  constexpr std::uint64_t kProcessIdentity = std::uint64_t{1} << 32;
+  if (identity.processId != 0) {
+    return kProcessIdentity | identity.processId;
+  }
+  return identity.clientId;
+}
diff --git a/tests/program_output_group_key_test.cpp b/tests/program_output_group_key_test.cpp
new file mode 100644
index 0000000..d409045
--- /dev/null
+++ b/tests/program_output_group_key_test.cpp
@@ -0,0 +1,18 @@
+#include "pipewire/program_output_group_key.h"
+
+#include <cassert>
+
+int main() {
+  const auto chromiumPrimary = programOutputGroupKey({.processId = 4242, .clientId = 10});
+  const auto chromiumTransient = programOutputGroupKey({.processId = 4242, .clientId = 11});
+  assert(chromiumPrimary == chromiumTransient);
+
+  const auto otherElectronApp = programOutputGroupKey({.processId = 4343, .clientId = 10});
+  assert(chromiumPrimary != otherElectronApp);
+
+  const auto legacyPrimary = programOutputGroupKey({.clientId = 20});
+  const auto legacySibling = programOutputGroupKey({.clientId = 20});
+  assert(legacyPrimary != 0);
+  assert(legacyPrimary == legacySibling);
+  assert(programOutputGroupKey({}) == 0);
+}
