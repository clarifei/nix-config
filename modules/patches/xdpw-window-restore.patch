+static bool dmenu_label_matches_toplevel(const char *label, const char *identifier) {
+	static const char prefix[] = "Window: ";
+	const size_t label_len = strlen(label);
+	const size_t identifier_len = strlen(identifier);
+	const size_t prefix_len = sizeof(prefix) - 1;
+
+	if (strncmp(label, prefix, prefix_len) != 0 ||
+			label_len < prefix_len + identifier_len + 3) {
+		return false;
+	}
+
+	const size_t identifier_offset = label_len - identifier_len - 1;
+	return label[identifier_offset - 2] == ' ' &&
+		label[identifier_offset - 1] == '(' &&
+		label[label_len - 1] == ')' &&
+		memcmp(label + identifier_offset, identifier, identifier_len) == 0;
+}
