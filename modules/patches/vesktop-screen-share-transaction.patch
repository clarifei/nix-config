diff --git a/src/main/utils/singleFlight.ts b/src/main/utils/singleFlight.ts
new file mode 100644
index 0000000..15bba23
--- /dev/null
+++ b/src/main/utils/singleFlight.ts
@@ -0,0 +1,25 @@
+/*
+ * Vesktop, a desktop app aiming to give you a snappier Discord Experience
+ * Copyright (c) 2023 Vendicated and Vencord contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+export class SingleFlight<T> {
+    private active: Promise<T> | null = null;
+
+    run(task: () => Promise<T>): Promise<T> {
+        if (this.active) return this.active;
+
+        const transaction = Promise.resolve().then(task);
+        this.active = transaction;
+        void transaction.then(
+            () => this.clear(transaction),
+            () => this.clear(transaction)
+        );
+        return transaction;
+    }
+
+    private clear(transaction: Promise<T>) {
+        if (this.active === transaction) this.active = null;
+    }
+}
