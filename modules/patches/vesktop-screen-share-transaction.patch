@@ -0,0 +1,42 @@
+/*
+ * Vesktop, a desktop app aiming to give you a snappier Discord Experience
+ * Copyright (c) 2023 Vendicated and Vencord contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { SingleFlight } from "../src/main/utils/singleFlight.ts";
+
+test("coalesces overlapping requests and starts a new transaction after completion", async () => {
+    const singleFlight = new SingleFlight<number>();
+    let starts = 0;
+    let release!: (value: number) => void;
+    const gate = new Promise<number>(resolve => (release = resolve));
+
+    const first = singleFlight.run(() => {
+        starts++;
+        return gate;
+    });
+    const second = singleFlight.run(() => {
+        starts++;
+        return Promise.resolve(2);
+    });
+
+    assert.strictEqual(first, second);
+    assert.strictEqual(starts, 0);
+    release(1);
+    assert.deepEqual(await Promise.all([first, second]), [1, 1]);
+    assert.strictEqual(starts, 1);
+
+    assert.strictEqual(await singleFlight.run(async () => ++starts), 2);
+});
+
+test("clears a rejected transaction", async () => {
+    const singleFlight = new SingleFlight<number>();
+    const failure = new Error("expected");
+
+    await assert.rejects(singleFlight.run(() => Promise.reject(failure)), failure);
+    assert.strictEqual(await singleFlight.run(async () => 7), 7);
+});
