+			action_get_str(action, "command", NULL));
+		break;
+	case ACTION_TYPE_EXPORT_WINDOW_LIST:
+		export_window_list();
+		break;
 	case ACTION_TYPE_EXIT:
 		wl_display_terminate(server.wl_display);
 		break;
