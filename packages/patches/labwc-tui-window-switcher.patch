+
+void
+keyboard_execute_on_modifiers_release(const char *command)
+{
+	should_execute_modifiers_release_command_on_next_key_release = false;
+	xstrdup_replace(modifiers_release_command, command);
+}
+
+static void
+execute_modifiers_release_command(void)
+{
+	assert(modifiers_release_command);
+	char *command = modifiers_release_command;
+	modifiers_release_command = NULL;
+	should_execute_modifiers_release_command_on_next_key_release = false;
+	spawn_async_no_shell(command);
+	free(command);
+}
