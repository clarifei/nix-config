+static struct wl_event_source *window_switcher_signal_source;
+static uint64_t window_switcher_instance;
+static uint64_t window_switcher_pidfd_inode;
+static uint64_t window_switcher_generation_counter;
+static int window_switcher_pidfd = -1;
+static char window_switcher_generation[96];
+
+static bool
+window_switcher_path(struct buf *path, const char *kind,
+	const char *generation)
+{
+	const char *runtime_dir = getenv("XDG_RUNTIME_DIR");
+	if (!runtime_dir || runtime_dir[0] != '/') {
+		wlr_log(WLR_ERROR,
+			"Cannot use window switcher without an absolute XDG_RUNTIME_DIR");
+		return false;
+	}
+	buf_add_fmt(path, "%s/labwc-window-switcher-%s.%s",
+		runtime_dir, kind, generation);
+	return true;
+}
+
+static int
+handle_window_switcher_focus(int signal, void *data)
+{
+	(void)signal;
+	(void)data;
+
+	if (!window_switcher_generation[0]) {
+		return 0;
+	}
+
+	struct buf path = BUF_INIT;
+	if (!window_switcher_path(&path, "focus", window_switcher_generation)) {
+		return 0;
+	}
+
+	int fd = open(path.data, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0) {
+		if (errno != ENOENT) {
+			wlr_log_errno(WLR_ERROR, "Failed to open window focus request");
+		}
+		goto cleanup;
+	}
+
+	struct stat stat_buffer = {0};
+	char request[32];
+	ssize_t length = -1;
+	if (fstat(fd, &stat_buffer) == 0
+			&& S_ISREG(stat_buffer.st_mode)
+			&& stat_buffer.st_uid == geteuid()
+			&& stat_buffer.st_size > 0
+			&& stat_buffer.st_size < (off_t)sizeof(request)) {
+		length = 0;
+		while (length < stat_buffer.st_size) {
+			ssize_t count = read(fd, request + length,
+				stat_buffer.st_size - length);
+			if (count < 0 && errno == EINTR) {
+				continue;
+			}
+			if (count <= 0) {
+				length = -1;
+				break;
+			}
+			length += count;
+		}
+	}
+	if (length <= 0 || length != stat_buffer.st_size) {
+		wlr_log(WLR_ERROR, "Invalid window focus request");
+		goto reject;
+	}
+	request[length] = '\0';
+
+	errno = 0;
+	char *end = NULL;
+	uintmax_t id = strtoumax(request, &end, 10);
+	if (errno || end == request || id > UINT64_MAX
+			|| (*end && !(*end == '\n' && !end[1]))) {
+		wlr_log(WLR_ERROR, "Invalid window id in focus request");
+		goto reject;
+	}
+
+	bool focused = false;
+	struct view *view;
+	for_each_view(view, &server.views, LAB_VIEW_CRITERIA_NONE) {
+		if (view->creation_id == (uint64_t)id) {
+			desktop_focus_view(view, /*raise*/ true);
+			focused = true;
+			break;
+		}
+	}
+	if (focused) {
+		close(fd);
+		unlink(path.data);
+		goto cleanup;
+	}
+
+reject:
+	if (ftruncate(fd, 0) < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to reject window focus request");
+	}
+	close(fd);
+cleanup:
+	buf_reset(&path);
+	return 0;
+}
+
+static uint64_t
+read_process_start_time(void)
+{
+	FILE *stream = fopen("/proc/self/stat", "r");
+	if (!stream) {
+		return 0;
+	}
+
+	char *line = NULL;
+	size_t capacity = 0;
+	ssize_t length = getline(&line, &capacity, stream);
+	fclose(stream);
+	if (length <= 0) {
+		free(line);
+		return 0;
+	}
+
+	/* Fields after comm start at process state (field 3). */
+	char *field = strrchr(line, ')');
+	if (!field || field[1] != ' ') {
+		free(line);
+		return 0;
+	}
+	field += 2;
+	for (int i = 0; i < 19; ++i) {
+		field = strchr(field, ' ');
+		if (!field) {
+			free(line);
+			return 0;
+		}
+		field += strspn(field, " ");
+	}
+
+	errno = 0;
+	char *end = NULL;
+	uintmax_t value = strtoumax(field, &end, 10);
+	bool valid = !errno && end != field && value <= UINT64_MAX
+		&& (*end == ' ' || *end == '\n' || !*end);
+	free(line);
+	return valid ? (uint64_t)value : 0;
+}
+
+void
+window_switcher_init(void)
+{
+	unsetenv("LABWC_WINDOW_SWITCHER_GENERATION");
+	window_switcher_instance = read_process_start_time();
+	if (!window_switcher_instance) {
+		wlr_log(WLR_ERROR, "Failed to read Labwc process start time");
+		return;
+	}
+
+	window_switcher_pidfd = pidfd_open(getpid(), 0);
+	if (window_switcher_pidfd < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to open Labwc pidfd");
+		return;
+	}
+	struct statfs pidfd_fs = {0};
+	if (fstatfs(window_switcher_pidfd, &pidfd_fs) < 0
+			|| pidfd_fs.f_type != PID_FS_MAGIC) {
+		wlr_log(WLR_ERROR, "Labwc pidfd is not backed by pidfs");
+		close(window_switcher_pidfd);
+		window_switcher_pidfd = -1;
+		return;
+	}
+	struct stat pidfd_stat = {0};
+	if (fstat(window_switcher_pidfd, &pidfd_stat) < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to inspect Labwc pidfd");
+		close(window_switcher_pidfd);
+		window_switcher_pidfd = -1;
+		return;
+	}
+	window_switcher_pidfd_inode = pidfd_stat.st_ino;
+	if (!window_switcher_pidfd_inode) {
+		wlr_log(WLR_ERROR, "Labwc pidfd has no stable inode");
+		close(window_switcher_pidfd);
+		window_switcher_pidfd = -1;
+		return;
+	}
+
+	window_switcher_signal_source = wl_event_loop_add_signal(
+		server.wl_event_loop, SIGUSR1, handle_window_switcher_focus, NULL);
+	if (!window_switcher_signal_source) {
+		wlr_log(WLR_ERROR, "Failed to register window-switcher signal");
+		close(window_switcher_pidfd);
+		window_switcher_pidfd = -1;
+	}
+}
+
+void
+window_switcher_finish(void)
+{
+	keyboard_reset_modifiers_release_command();
+	if (window_switcher_signal_source) {
+		wl_event_source_remove(window_switcher_signal_source);
+		window_switcher_signal_source = NULL;
+	}
+	if (window_switcher_pidfd >= 0) {
+		close(window_switcher_pidfd);
+		window_switcher_pidfd = -1;
+	}
+	unsetenv("LABWC_WINDOW_SWITCHER_GENERATION");
+}
+
+static bool
+write_window_field(FILE *stream, const char *field)
+{
+	size_t length = strlen(field);
+	return fwrite(field, 1, length, stream) == length
+		&& fputc('\0', stream) != EOF;
+}
+
+static void
+export_window_list(void)
+{
+	window_switcher_generation[0] = '\0';
+	unsetenv("LABWC_WINDOW_SWITCHER_GENERATION");
+	if (!window_switcher_signal_source) {
+		return;
+	}
+
+	uint64_t next_generation = window_switcher_generation_counter + 1;
+	if (!next_generation) {
+		next_generation = 1;
+	}
+	char generation[96];
+	snprintf(generation, sizeof(generation), "%ld-%llu-%llu-%llu",
+		(long)getpid(), (unsigned long long)window_switcher_instance,
+		(unsigned long long)window_switcher_pidfd_inode,
+		(unsigned long long)next_generation);
+
+	struct buf path = BUF_INIT;
+	struct buf temporary_path = BUF_INIT;
+	if (!window_switcher_path(&path, "windows", generation)) {
+		goto cleanup;
+	}
+	buf_add_fmt(&temporary_path, "%s.tmp", path.data);
+
+	int fd = open(temporary_path.data,
+		O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to open window-list export");
+		goto cleanup;
+	}
+	if (fchmod(fd, 0600) < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to secure window-list export");
+		close(fd);
+		goto unlink_temporary;
+	}
+
+	FILE *stream = fdopen(fd, "w");
+	if (!stream) {
+		wlr_log_errno(WLR_ERROR, "Failed to create window-list stream");
+		close(fd);
+		goto unlink_temporary;
+	}
+
+	bool success = true;
+	enum lab_view_criteria criteria =
+		LAB_VIEW_CRITERIA_NO_SKIP_WINDOW_SWITCHER
+		| LAB_VIEW_CRITERIA_NO_DIALOG;
+	struct view *view;
+	for_each_view(view, &server.views, criteria) {
+		char id[32];
+		snprintf(id, sizeof(id), "%llu",
+			(unsigned long long)view->creation_id);
+		const char *active = view == server.active_view ? "1" : "0";
+		const char *workspace = view->visible_on_all_workspaces
+			? "*"
+			: view->workspace->name;
+		if (!write_window_field(stream, id)
+				|| !write_window_field(stream, active)
+				|| !write_window_field(stream, workspace)
+				|| !write_window_field(stream, view->app_id)
+				|| !write_window_field(stream, view->title)) {
+			success = false;
+			break;
+		}
+	}
+
+	if (fclose(stream) < 0) {
+		success = false;
+	}
+
+	if (!success) {
+		wlr_log_errno(WLR_ERROR, "Failed to write window-list export");
+		goto unlink_temporary;
+	}
+	if (rename(temporary_path.data, path.data) < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to publish window-list export");
+		goto unlink_temporary;
+	}
+	if (setenv("LABWC_WINDOW_SWITCHER_GENERATION", generation, true) < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to publish window-list generation");
+		unlink(path.data);
+		goto cleanup;
+	}
+	window_switcher_generation_counter = next_generation;
+	snprintf(window_switcher_generation,
+		sizeof(window_switcher_generation), "%s", generation);
+	goto cleanup;
+
+unlink_temporary:
+	unlink(temporary_path.data);
+cleanup:
+	buf_reset(&temporary_path);
+	buf_reset(&path);
+}
