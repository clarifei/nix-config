+static void
+export_window_list(void)
+{
+	const char *runtime_dir = getenv("XDG_RUNTIME_DIR");
+	if (!runtime_dir || runtime_dir[0] != '/') {
+		wlr_log(WLR_ERROR,
+			"Cannot export window list without an absolute XDG_RUNTIME_DIR");
+		return;
+	}
+
+	struct buf path = BUF_INIT;
+	struct buf temporary_path = BUF_INIT;
+	buf_add_fmt(&path, "%s/labwc-window-switcher-windows", runtime_dir);
+	buf_add_fmt(&temporary_path, "%s.tmp", path.data);
+
+	int fd = open(temporary_path.data,
+		O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to open window-list export");
+		goto cleanup;
+	}
+	if (fchmod(fd, 0600) < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to secure window-list export");
+		close(fd);
+		goto unlink_temporary;
+	}
+
+	FILE *stream = fdopen(fd, "w");
+	if (!stream) {
+		wlr_log_errno(WLR_ERROR, "Failed to create window-list stream");
+		close(fd);
+		goto unlink_temporary;
+	}
+
+	bool success = true;
+	enum lab_view_criteria criteria =
+		LAB_VIEW_CRITERIA_NO_SKIP_WINDOW_SWITCHER
+		| LAB_VIEW_CRITERIA_NO_DIALOG;
+	struct view *view;
+	for_each_view(view, &server.views, criteria) {
+
+		char id[32];
+		snprintf(id, sizeof(id), "%" PRIu64, view->creation_id);
+		const char *active = view == server.active_view ? "1" : "0";
+		const char *workspace = view->visible_on_all_workspaces
+			? "*"
+			: view->workspace->name;
+		const char *fields[] = {
+			id, active, workspace, view->app_id, view->title
+		};
+
+		for (size_t i = 0; i < ARRAY_SIZE(fields); ++i) {
+			size_t len = strlen(fields[i]);
+			if (fwrite(fields[i], 1, len, stream) != len
+					|| fputc('\0', stream) == EOF) {
+				success = false;
+				break;
+			}
+		}
+		if (!success) {
+			break;
+		}
+	}
+
+	if (success && fflush(stream) < 0) {
+		success = false;
+	}
+	if (success && fsync(fd) < 0) {
+		success = false;
+	}
+	if (fclose(stream) < 0) {
+		success = false;
+	}
+
+	if (!success) {
+		wlr_log_errno(WLR_ERROR, "Failed to write window-list export");
+		goto unlink_temporary;
+	}
+	if (rename(temporary_path.data, path.data) < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to publish window-list export");
+		goto unlink_temporary;
+	}
+	goto cleanup;
+
+unlink_temporary:
+	unlink(temporary_path.data);
+cleanup:
+	buf_reset(&temporary_path);
+	buf_reset(&path);
+}
+
 static void
 run_action(struct view *view, struct action *action,
 	struct cursor_context *ctx)
@@ -1088,6 +1187,13 @@ run_action(struct view *view, struct action *action,
