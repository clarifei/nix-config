diff --git a/src/config/rcxml.c b/src/config/rcxml.c
index ab0639d..e67e314 100644
--- a/src/config/rcxml.c
+++ b/src/config/rcxml.c
@@ -1201,6 +1201,34 @@ entry(xmlNode *node, char *nodename, char *content)
 		set_bool(content, &rc.shadows_enabled);
 	} else if (!strcasecmp(nodename, "dropShadowsOnTiled.theme")) {
 		set_bool(content, &rc.shadows_on_tiled);
+	} else if (!strcasecmp(nodename, "enabled.windowEffects")) {
+		set_bool(content, &rc.window_effects.enabled);
+	} else if (!strcasecmp(nodename, "activeOpacity.windowEffects")) {
+		set_float(content, &rc.window_effects.active_opacity);
+		rc.window_effects.active_opacity = MAX(0.0f,
+			MIN(1.0f, rc.window_effects.active_opacity));
+	} else if (!strcasecmp(nodename, "inactiveOpacity.windowEffects")) {
+		set_float(content, &rc.window_effects.inactive_opacity);
+		rc.window_effects.inactive_opacity = MAX(0.0f,
+			MIN(1.0f, rc.window_effects.inactive_opacity));
+	} else if (!strcasecmp(nodename, "enabled.blur.windowEffects")) {
+		set_bool(content, &rc.window_effects.blur_enabled);
+	} else if (!strcasecmp(nodename, "passes.blur.windowEffects")) {
+		rc.window_effects.blur_passes = MAX(0, MIN(10, atoi(content)));
+	} else if (!strcasecmp(nodename, "radius.blur.windowEffects")) {
+		rc.window_effects.blur_radius = MAX(0, MIN(10, atoi(content)));
+	} else if (!strcasecmp(nodename, "brightness.blur.windowEffects")) {
+		set_float(content, &rc.window_effects.blur_brightness);
+		rc.window_effects.blur_brightness = MAX(0.0f,
+			MIN(2.0f, rc.window_effects.blur_brightness));
+	} else if (!strcasecmp(nodename, "contrast.blur.windowEffects")) {
+		set_float(content, &rc.window_effects.blur_contrast);
+		rc.window_effects.blur_contrast = MAX(0.0f,
+			MIN(2.0f, rc.window_effects.blur_contrast));
+	} else if (!strcasecmp(nodename, "saturation.blur.windowEffects")) {
+		set_float(content, &rc.window_effects.blur_saturation);
+		rc.window_effects.blur_saturation = MAX(0.0f,
+			MIN(2.0f, rc.window_effects.blur_saturation));
 	} else if (!strcasecmp(nodename, "followMouse.focus")) {
 		set_bool(content, &rc.focus_follow_mouse);
 	} else if (!strcasecmp(nodename, "followMouseRequiresMovement.focus")) {
@@ -1526,6 +1554,15 @@ rcxml_init(void)
 	rc.corner_radius = 8;
 	rc.shadows_enabled = false;
 	rc.shadows_on_tiled = false;
+	rc.window_effects.enabled = false;
+	rc.window_effects.active_opacity = 1.0f;
+	rc.window_effects.inactive_opacity = 1.0f;
+	rc.window_effects.blur_enabled = false;
+	rc.window_effects.blur_passes = 3;
+	rc.window_effects.blur_radius = 5;
+	rc.window_effects.blur_brightness = 0.9f;
+	rc.window_effects.blur_contrast = 0.9f;
+	rc.window_effects.blur_saturation = 1.1f;
 
 	rc.gap = 0;
 	rc.adaptive_sync = LAB_ADAPTIVE_SYNC_DISABLED;
