+static void
+set_window_opacity(struct wlr_scene_buffer *buffer, int sx, int sy, void *data)
+{
+	(void)sx;
+	(void)sy;
+	float opacity = *(float *)data;
+	struct wlr_scene_surface *surface =
+		wlr_scene_surface_try_from_buffer(buffer);
+	if (surface) {
+		const struct wlr_alpha_modifier_surface_v1_state *alpha =
+			wlr_alpha_modifier_v1_get_surface_state(surface->surface);
+		if (alpha) {
+			opacity *= alpha->multiplier;
+		}
+	}
+	wlr_scene_buffer_set_opacity(buffer, opacity);
+}
+
+void
+view_effects_create(struct view *view)
+{
+	assert(view);
+	assert(view->scene_tree);
+	assert(!view->effects.blur);
+
+	view->effects.blur = wlr_scene_blur_create(view->scene_tree, 0, 0);
+	die_if_null(view->effects.blur);
+	wlr_scene_node_lower_to_bottom(&view->effects.blur->node);
+	view_effects_update(view);
+}
+
+void
+view_effects_update(struct view *view)
+{
+	assert(view);
+
+	bool enabled = rc.window_effects.enabled && !view->fullscreen;
+	float opacity = 1.0f;
+	if (enabled) {
+		opacity = view->effects.activated
+			? rc.window_effects.active_opacity
+			: rc.window_effects.inactive_opacity;
+	}
+	if (view->content_tree) {
+		wlr_scene_node_for_each_buffer(&view->content_tree->node,
+			set_window_opacity, &opacity);
+	}
+
+	if (!view->effects.blur) {
+		return;
+	}
+	int height = view_effective_height(view, /* use_pending */ false);
+	bool blur_enabled = enabled && rc.window_effects.blur_enabled
+		&& opacity < 1.0f && view->current.width > 0 && height > 0;
+	wlr_scene_node_set_enabled(&view->effects.blur->node, blur_enabled);
+	if (blur_enabled) {
+		wlr_scene_blur_set_size(view->effects.blur,
+			view->current.width, height);
+	}
+}
+
+void
+view_effects_update_all(void)
+{
+	struct view *view;
+	wl_list_for_each(view, &server.views, link) {
+		view_effects_update(view);
+	}
+}
+
+void
+view_effects_reconfigure(void)
+{
+	if (!server.scene) {
+		return;
+	}
+	wlr_scene_set_blur_data(server.scene,
+		rc.window_effects.blur_passes,
+		rc.window_effects.blur_radius,
+		rc.window_effects.blur_noise,
+		rc.window_effects.blur_brightness,
+		rc.window_effects.blur_contrast,
+		rc.window_effects.blur_saturation);
+	view_effects_update_all();
+}
+
