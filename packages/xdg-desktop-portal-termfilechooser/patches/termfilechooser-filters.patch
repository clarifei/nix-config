+static void get_filters_path(char *path, size_t size)
+{
+    snprintf(path, size, "%s-%u.filters", PATH_PORTAL_BASE, getuid());
+}
+
+static int write_filter_record(FILE *fp, const char *value)
+{
+    size_t size = strlen(value) + 1;
+    return fwrite(value, 1, size, fp) == size ? 0 : -EIO;
+}
+
+static int serialize_filters(sd_bus_message *msg, const char *filename)
+{
+    int fd = open(filename,
+                  O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) {
+        return -errno;
+    }
+
+    FILE *fp = fdopen(fd, "wb");
+    if (fp == NULL) {
+        int ret = -errno;
+        close(fd);
+        return ret;
+    }
+
+    int ret = sd_bus_message_enter_container(msg, 'v', "a(sa(us))");
+    if (ret < 0) {
+        goto fail;
+    }
+
+    ret = sd_bus_message_enter_container(msg, 'a', "(sa(us))");
+    if (ret < 0) {
+        goto fail;
+    }
+
+    while ((ret = sd_bus_message_enter_container(msg, 'r', "sa(us)")) > 0) {
+        const char *name = NULL;
+        ret = sd_bus_message_read(msg, "s", &name);
+        if (ret < 0 || (ret = write_filter_record(fp, "filter")) < 0 ||
+            (ret = write_filter_record(fp, name)) < 0) {
+            goto fail;
+        }
+
+        ret = sd_bus_message_enter_container(msg, 'a', "(us)");
+        if (ret < 0) {
+            goto fail;
+        }
+
+        while ((ret = sd_bus_message_enter_container(msg, 'r', "us")) > 0) {
+            unsigned int kind = 0;
+            const char *pattern = NULL;
+            ret = sd_bus_message_read(msg, "us", &kind, &pattern);
+            if (ret < 0) {
+                goto fail;
+            }
+
+            if (kind <= 1) {
+                char kind_string[2] = {(char)('0' + kind), '\0'};
+                if ((ret = write_filter_record(fp, "rule")) < 0 ||
+                    (ret = write_filter_record(fp, kind_string)) < 0 ||
+                    (ret = write_filter_record(fp, pattern)) < 0) {
+                    goto fail;
+                }
+            }
+
+            ret = sd_bus_message_exit_container(msg);
+            if (ret < 0) {
+                goto fail;
+            }
+        }
+        if (ret < 0) {
+            goto fail;
+        }
+
+        ret = sd_bus_message_exit_container(msg);
+        if (ret < 0 || (ret = write_filter_record(fp, "end-filter")) < 0) {
+            goto fail;
+        }
+
+        ret = sd_bus_message_exit_container(msg);
+        if (ret < 0) {
+            goto fail;
+        }
+    }
+    if (ret < 0) {
+        goto fail;
+    }
+
+    ret = sd_bus_message_exit_container(msg);
+    if (ret < 0) {
+        goto fail;
+    }
+    ret = sd_bus_message_exit_container(msg);
+    if (ret < 0 || (ret = write_filter_record(fp, "end")) < 0) {
+        goto fail;
+    }
+
+    if (fclose(fp) != 0) {
+        remove(filename);
+        return -EIO;
+    }
+    return 0;
+
+fail:
+    fclose(fp);
+    remove(filename);
+    return ret;
+}
