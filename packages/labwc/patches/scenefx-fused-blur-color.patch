-}
-
-mat4 saturationMatrix() {
-	vec3 luminance = vec3(0.3086, 0.6094, 0.0820) * (1.0 - saturation);
-	vec3 red = vec3(luminance.x);
-	red.x += saturation;
-	vec3 green = vec3(luminance.y);
-	green.y += saturation;
