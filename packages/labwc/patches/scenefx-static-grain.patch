diff --git a/render/fx_renderer/fx_pass.c b/render/fx_renderer/fx_pass.c
index d398510..0ef4999 100644
--- a/render/fx_renderer/fx_pass.c
+++ b/render/fx_renderer/fx_pass.c
@@ -838,6 +838,7 @@ static void render_blur_segments(struct fx_gles_render_pass *pass,
 	struct wlr_render_texture_options *options = &tex_options->base;
 	struct fx_renderer *renderer = pass->buffer->renderer;
 	struct blur_data *blur_data = fx_options->blur_data;
+	bool grain_bound = false;
 
 	TRACY_BOTH_ZONES_START(renderer);
 	push_fx_debug(renderer);
@@ -902,6 +903,21 @@ static void render_blur_segments(struct fx_gles_render_pass *pass,
 			glUniform1f(shader->contrast, blur_data->contrast);
 			glUniform1f(shader->saturation, blur_data->saturation);
 		}
+		bool apply_grain = apply_color_adjustments
+			&& blur_data_has_grain(blur_data);
+		glUniform1i(shader->apply_grain, apply_grain);
+		if (apply_grain) {
+			glActiveTexture(GL_TEXTURE1);
+			glBindTexture(GL_TEXTURE_2D, renderer->grain_texture);
+			grain_bound = true;
+			glUniform1i(shader->grain_tex, 1);
+			glUniform2f(shader->grain_texel_size,
+				1.0f / FX_GRAIN_TEXTURE_SIZE,
+				1.0f / FX_GRAIN_TEXTURE_SIZE);
+			glUniform1f(shader->grain_amount, blur_data->grain_amount);
+			glUniform1f(shader->grain_size, blur_data->grain_size);
+			glActiveTexture(GL_TEXTURE0);
+		}
 	}
 
 	set_proj_matrix(shader->proj, pass->projection_matrix, &dst_box);
@@ -910,6 +926,11 @@ static void render_blur_segments(struct fx_gles_render_pass *pass,
 	render(&dst_box, options->clip, shader->pos_attrib);
 
 	glBindTexture(texture->target, 0);
+	if (grain_bound) {
+		glActiveTexture(GL_TEXTURE1);
+		glBindTexture(GL_TEXTURE_2D, 0);
+		glActiveTexture(GL_TEXTURE0);
+	}
 	pop_fx_debug(renderer);
 	TRACY_BOTH_ZONES_END;
 
diff --git a/render/fx_renderer/fx_renderer.c b/render/fx_renderer/fx_renderer.c
index df9b940..36771a2 100644
--- a/render/fx_renderer/fx_renderer.c
+++ b/render/fx_renderer/fx_renderer.c
@@ -6,6 +6,7 @@
 #include <assert.h>
 #include <drm_fourcc.h>
 #include <GLES2/gl2.h>
+#include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <unistd.h>
@@ -31,6 +32,70 @@
 static const struct wlr_renderer_impl renderer_impl;
 static const struct wlr_render_timer_impl render_timer_impl;
 
+// PCG-XSH-RR, based on pcg32_random_r from pcg-c-basic (Apache-2.0).
+struct pcg32_state {
+	uint64_t state;
+	uint64_t increment;
+};
+
+static uint32_t pcg32(struct pcg32_state *rng) {
+	uint64_t old_state = rng->state;
+	rng->state = old_state * 6364136223846793005ULL + rng->increment;
+	uint32_t xorshifted = (uint32_t)(((old_state >> 18u) ^ old_state) >> 27u);
+	uint32_t rotation = (uint32_t)(old_state >> 59u);
+	return (xorshifted >> rotation) |
+		(xorshifted << ((-rotation) & 31));
+}
+
+static bool init_grain_texture(struct fx_renderer *renderer) {
+	size_t pixel_count =
+		(size_t)FX_GRAIN_TEXTURE_SIZE * FX_GRAIN_TEXTURE_SIZE;
+	uint8_t *pixels = malloc(pixel_count * 4);
+	if (!pixels) {
+		wlr_log(WLR_ERROR, "Failed to allocate static grain texture");
+		return false;
+	}
+
+	struct pcg32_state rng = {
+		.state = 0x853c49e6748fea9bULL,
+		.increment = 0xda3e39cb94b95bdbULL,
+	};
+	for (size_t i = 0; i < pixel_count; ++i) {
+		uint16_t a = pcg32(&rng) >> 24;
+		uint16_t b = pcg32(&rng) >> 24;
+		uint8_t value = (a + b + 1) / 2;
+		pixels[i * 4 + 0] = value;
+		pixels[i * 4 + 1] = value;
+		pixels[i * 4 + 2] = value;
+		pixels[i * 4 + 3] = 255;
+	}
+
+	for (int i = 0; i < 8 && glGetError() != GL_NO_ERROR; ++i) {
+		// Drain the finite GL error queue before checking the upload.
+	}
+	glActiveTexture(GL_TEXTURE0);
+	glGenTextures(1, &renderer->grain_texture);
+	glBindTexture(GL_TEXTURE_2D, renderer->grain_texture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, FX_GRAIN_TEXTURE_SIZE,
+		FX_GRAIN_TEXTURE_SIZE, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	glBindTexture(GL_TEXTURE_2D, 0);
+	free(pixels);
+
+	GLenum error = glGetError();
+	if (renderer->grain_texture == 0 || error != GL_NO_ERROR) {
+		wlr_log(WLR_ERROR, "Failed to create static grain texture (GL error 0x%x)",
+			error);
+		glDeleteTextures(1, &renderer->grain_texture);
+		renderer->grain_texture = 0;
+		return false;
+	}
+	return true;
+}
+
 bool wlr_renderer_is_fx(struct wlr_renderer *wlr_renderer) {
 	return wlr_renderer->impl == &renderer_impl;
 }
@@ -100,6 +165,13 @@ static inline void free_shaders(struct fx_renderer *renderer) {
 	pop_fx_debug(renderer);
 }
 
+static void free_grain_texture(struct fx_renderer *renderer) {
+	if (renderer->grain_texture != 0) {
+		glDeleteTextures(1, &renderer->grain_texture);
+		renderer->grain_texture = 0;
+	}
+}
+
 static void fx_renderer_destroy(struct wlr_renderer *wlr_renderer) {
 	struct fx_renderer *renderer = fx_get_renderer(wlr_renderer);
 
@@ -122,6 +194,7 @@ static void fx_renderer_destroy(struct wlr_renderer *wlr_renderer) {
 		fx_framebuffer_destroy(buffer);
 	}
 
+	free_grain_texture(renderer);
 	free_shaders(renderer);
 
 	if (renderer->exts.KHR_debug) {
@@ -569,6 +642,9 @@ struct wlr_renderer *fx_renderer_create_egl(struct wlr_egl *egl) {
 	TRACY_FN(
 		renderer->tracy_data = TRACY_GPU_CONTEXT_NEW(renderer);
 	)
+	if (!init_grain_texture(renderer)) {
+		goto error;
+	}
 
 	// Link all shaders
 	if (!link_shaders(renderer)) {
@@ -594,6 +670,7 @@ struct wlr_renderer *fx_renderer_create_egl(struct wlr_egl *egl) {
 
 error:
 	pop_fx_debug(renderer);
+	free_grain_texture(renderer);
 
 	if (renderer->exts.KHR_debug) {
 		glDisable(GL_DEBUG_OUTPUT_KHR);
diff --git a/render/fx_renderer/shaders.c b/render/fx_renderer/shaders.c
index 374cc10..1788954 100644
--- a/render/fx_renderer/shaders.c
+++ b/render/fx_renderer/shaders.c
@@ -342,6 +342,11 @@ bool link_blur2_program(struct blur_shader *shader) {
 	shader->brightness = glGetUniformLocation(prog, "brightness");
 	shader->contrast = glGetUniformLocation(prog, "contrast");
 	shader->saturation = glGetUniformLocation(prog, "saturation");
+	shader->apply_grain = glGetUniformLocation(prog, "apply_grain");
+	shader->grain_tex = glGetUniformLocation(prog, "grain_tex");
+	shader->grain_texel_size = glGetUniformLocation(prog, "grain_texel_size");
+	shader->grain_amount = glGetUniformLocation(prog, "grain_amount");
+	shader->grain_size = glGetUniformLocation(prog, "grain_size");
 
 	return true;
 }
diff --git a/render/fx_renderer/shaders/blur2.frag b/render/fx_renderer/shaders/blur2.frag
index 38cf5eb..02f704b 100644
--- a/render/fx_renderer/shaders/blur2.frag
+++ b/render/fx_renderer/shaders/blur2.frag
@@ -13,6 +13,11 @@ uniform bool apply_color_adjustments;
 uniform float brightness;
 uniform float contrast;
 uniform float saturation;
+uniform bool apply_grain;
+uniform sampler2D grain_tex;
+uniform vec2 grain_texel_size;
+uniform float grain_amount;
+uniform float grain_size;
 
 mat4 brightnessMatrix() {
 	float b = brightness - 1.0;
@@ -62,5 +67,12 @@ void main() {
 		// Keep the same matrix order as the former post-processing pass.
 		color = brightnessMatrix() * contrastMatrix() * saturationMatrix() * color;
 	}
+	if (apply_grain) {
+		vec2 grain_uv = gl_FragCoord.xy * grain_texel_size /
+			max(grain_size, 1.0);
+		float noise = texture2D(grain_tex, grain_uv).r * 2.0 - 1.0;
+		float delta = noise * grain_amount * color.a;
+		color.rgb = clamp(color.rgb + vec3(delta), vec3(0.0), vec3(color.a));
+	}
 	gl_FragColor = color;
 }
diff --git a/types/fx/blur_data.c b/types/fx/blur_data.c
index ae8fef0..fa7cc39 100644
--- a/types/fx/blur_data.c
+++ b/types/fx/blur_data.c
@@ -4,6 +4,8 @@ struct blur_data blur_data_get_default(void) {
 	return (struct blur_data) {
 		.radius = 5,
 		.num_passes = 3,
+		.grain_amount = 0.0f,
+		.grain_size = 1.0f,
 		.brightness = 0.9,
 		.contrast = 0.9,
 		.saturation = 1.1,
@@ -20,6 +22,10 @@ bool blur_data_should_parameters_blur_effects(struct blur_data *blur_data) {
 		|| blur_data->contrast != 1.0f;
 }
 
+bool blur_data_has_grain(const struct blur_data *blur_data) {
+	return blur_data->grain_amount > 0.0f;
+}
+
 int blur_data_calc_size(struct blur_data *blur_data) {
 	return pow(2, blur_data->num_passes + 1) * blur_data->radius;
 }
@@ -29,6 +35,7 @@ static float lerp(float a, float b, float f) {
 }
 
 static void adjust_post_effects(struct blur_data *blur_data, float strength) {
+	blur_data->grain_amount = lerp(0.0f, blur_data->grain_amount, strength);
 	blur_data->brightness = lerp(1.0, blur_data->brightness, strength);
 	blur_data->contrast = lerp(1.0, blur_data->contrast, strength);
 	blur_data->saturation = lerp(1.0, blur_data->saturation, strength);
diff --git a/types/scene/wlr_scene.c b/types/scene/wlr_scene.c
index dc68a5d..41dac30 100644
--- a/types/scene/wlr_scene.c
+++ b/types/scene/wlr_scene.c
@@ -1307,6 +1307,20 @@ void wlr_scene_set_blur_data(struct wlr_scene *scene, int num_passes,
 	scene_node_update(&scene->tree.node, NULL);
 }
 
+void wlr_scene_set_blur_grain(struct wlr_scene *scene, float amount,
+		float size) {
+	struct blur_data *blur_data = &scene->blur_data;
+	if (blur_data->grain_amount == amount && blur_data->grain_size == size) {
+		return;
+	}
+
+	blur_data->grain_amount = amount;
+	blur_data->grain_size = size;
+
+	mark_all_optimized_blur_nodes_dirty(&scene->tree.node);
+	scene_node_update(&scene->tree.node, NULL);
+}
+
 void wlr_scene_set_blur_num_passes(struct wlr_scene *scene, int num_passes) {
 	struct blur_data *buff_data = &scene->blur_data;
 	if (buff_data->num_passes == num_passes) {
