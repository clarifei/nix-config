 #define LAB_LAYERSHELL_VERSION 4
 
+static struct wl_list layer_surfaces = WL_LIST_INIT(&layer_surfaces);
+
+static void
+set_layer_opacity(struct wlr_scene_buffer *buffer, int sx, int sy, void *data)
+{
+	(void)sx;
+	(void)sy;
+	float opacity = *(float *)data;
+	struct wlr_scene_surface *surface =
+		wlr_scene_surface_try_from_buffer(buffer);
+	if (surface) {
+		const struct wlr_alpha_modifier_surface_v1_state *alpha =
+			wlr_alpha_modifier_v1_get_surface_state(
+				surface->surface);
+		if (alpha) {
+			opacity *= alpha->multiplier;
+		}
+	}
+	wlr_scene_buffer_set_opacity(buffer, opacity);
+}
+
+struct mask_lookup {
+	struct wlr_surface *surface;
+	struct wlr_scene_buffer *buffer;
+};
+
+static void
+find_surface_buffer(struct wlr_scene_buffer *buffer, int sx, int sy, void *data)
+{
+	(void)sx;
+	(void)sy;
+	struct mask_lookup *lookup = data;
+	struct wlr_scene_surface *surface =
+		wlr_scene_surface_try_from_buffer(buffer);
+	if (!lookup->buffer && surface && surface->surface == lookup->surface) {
+		lookup->buffer = buffer;
+	}
+}
+
+static void
+layer_effects_update(struct lab_layer_surface *layer)
+{
+	struct wlr_surface *surface = layer->layer_surface->surface;
+	const pixman_region32_t *requested_region =
+		background_effects_get_blur_region(surface);
+	pixman_region32_t region;
+	pixman_region32_init(&region);
+	if (requested_region && surface->current.width > 0
+		&& surface->current.height > 0) {
+		pixman_region32_intersect_rect(&region, requested_region, 0, 0,
+			surface->current.width, surface->current.height);
+	}
+
+	bool requested = pixman_region32_not_empty(&region);
+	bool enabled = rc.window_effects.enabled
+		&& rc.window_effects.layer_shell.enabled && requested;
+	float opacity = enabled ? rc.window_effects.layer_shell.opacity : 1.0f;
+	wlr_scene_node_for_each_buffer(&layer->scene_layer_surface->tree->node,
+		set_layer_opacity, &opacity);
+
+	bool blur_enabled = enabled
+		&& rc.window_effects.blur_enabled;
+	if (blur_enabled) {
+		const pixman_box32_t *extents =
+			pixman_region32_extents(&region);
+		wlr_scene_node_set_position(&layer->effects.blur->node,
+			extents->x1, extents->y1);
+		wlr_scene_blur_set_size(layer->effects.blur,
+			extents->x2 - extents->x1, extents->y2 - extents->y1);
+
+		struct mask_lookup lookup = {.surface = surface};
+		wlr_scene_node_for_each_buffer(
+			&layer->scene_layer_surface->tree->node,
+			find_surface_buffer, &lookup);
+		if (lookup.buffer) {
+			wlr_scene_blur_set_transparency_mask_source(
+				layer->effects.blur, lookup.buffer);
+		}
+	}
+	wlr_scene_node_set_enabled(&layer->effects.blur->node, blur_enabled);
+	pixman_region32_fini(&region);
+}
+
+void
+layers_surface_effects_update(struct wlr_surface *surface)
+{
+	struct wlr_layer_surface_v1 *layer_surface =
+		wlr_layer_surface_v1_try_from_wlr_surface(surface);
+	if (layer_surface && layer_surface->data) {
+		layer_effects_update(layer_surface->data);
+	}
+}
+
+void
+layers_effects_reconfigure(void)
+{
+	struct lab_layer_surface *layer;
+	wl_list_for_each(layer, &layer_surfaces, link) {
+		layer_effects_update(layer);
+	}
+}
+
